<?xml version="1.0" encoding="utf-8"?>
<!--
  x0s wordmark monogram: a bold "X" built from two rounded diagonal strokes.
  Kept inside the ~66dp adaptive-icon safe zone (centered in the 108x108 canvas)
  so none of it gets clipped by circular/squircle/rounded-square launcher masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M36,36 L72,72"
        android:strokeColor="#007AFF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
    <path
        android:pathData="M72,36 L36,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round" />
</vector>
